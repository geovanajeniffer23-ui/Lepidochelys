# Generate a file containing the positions of the variants
bcftools query -f '%CHROM\t%POS\n' \
  /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/VCF/L.olivacea_13.vcf > /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Carga_Genética/est-sfs/positions.txt

# Combine with the ancestral allele inferred by est-sfs
paste positions.txt ancestral_states.txt > ancestral_positions.txt  


## Start Python script
import gzip

fasta_in = "/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Informações/GCA_965140295.1_rLepOli2.hap1_genomic.fasta"
ancestral_file = "/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Carga_Genética/est-sfs/ancestral_positions.txt"
fasta_out = "/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Carga_Genética/Fasta_ancestralizado/fasta_ancestralizado.fasta"
log_out = "/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Carga_Genética/Fasta_ancestralizado/mismatches_REF_vs_ANC.log"

LINE_LEN = 60

# 1) Carrega alelos ancestrais
ancestral = {}

with gzip.open(ancestral_file, "rt") as f:
    for line in f:
        chrom, pos, base = line.strip().split()
        ancestral.setdefault(chrom, {})[int(pos)] = base.upper()

print("Alelos ancestrais carregados.")

# 2) Processa FASTA
with open(fasta_in) as fin, open(fasta_out, "w") as fout, open(log_out, "w") as flog:
    chrom = None
    seq = []

    def write_seq(chrom, seq):
        s = list("".join(seq))

        if chrom in ancestral:
            for pos, anc in ancestral[chrom].items():
                if pos - 1 < len(s):
                    ref = s[pos - 1]
                    if ref.upper() != anc:
                        flog.write(f"{chrom}\t{pos}\t{ref}\t{anc}\n")
                    s[pos - 1] = anc

        # escrita eficiente em blocos
        for i in range(0, len(s), LINE_LEN):
            fout.write("".join(s[i:i+LINE_LEN]) + "\n")

    for line in fin:
        line = line.rstrip("\n")

        if line.startswith(">"):
            if chrom is not None:
                write_seq(chrom, seq)

            chrom = line[1:].split()[0]
            fout.write(line + "\n")
            seq = []
        else:
            seq.append(line)

    # último cromossomo
    if chrom is not None:
        write_seq(chrom, seq)

print("FASTA com alelos ancestrais gerado com sucesso!")
print(f"Log salvo em: {log_out}")


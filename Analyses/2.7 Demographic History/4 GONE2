# GONE2 does not support chromosome names containing letters. Therefore, we used the same VCF file with renamed chromosome identifiers for PHLASH

# Generate population-specific VCF files containing only the samples belonging to each population

# Brazil
bcftools view \
--samples ^Sample4,Sample5,Sample11,Sample12,Sample20,Sample19,Sample7,Sample1,Sample3,Sample15,Sample16,Sample26,Sample29,Sample24,Sample25,Sample28,Sample65,Sample66 \
-Oz -o /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Historia_Demografica/GONE2/L.olivacea_13_cromossomos_Brasil.vcf.gz \
/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Historia_Demografica/PHLASH/L.olivacea_13_cromossomos.vcf.gz

bcftools view -i 'AC>0 && AC<AN' \
  -Oz \
  -o  L.olivacea_13_cromossomos_Brasil_acan.vcf.gz \
  L.olivacea_13_cromossomos_Brasil.vcf.gz 

rm  L.olivacea_13_cromossomos_Brasil.vcf.gz 

mv  L.olivacea_13_cromossomos_Brasil_acan.vcf.gz L.olivacea_13_cromossomos_Brasil.vcf.gz 

# Indian

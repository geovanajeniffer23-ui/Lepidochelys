# Read the input file containing seven columns and identify the highest value in columns 4–7 of each line. Assign the corresponding base 
# (A for column 4, C for column 5, G for column 6, or T for column 7) and write the resulting base to a new file, with one base per line
LC_NUMERIC=C awk '
{
    max = $4
    idx = 4

    for (i = 5; i <= 7; i++) {
        if ($i > max) {
            max = $i
            idx = i
        }
    }

    if (idx == 4)
        print "A"
    else if (idx == 5)
        print "C"
    else if (idx == 6)
        print "G"
    else
        print "T"
}' MODIFICADO_output-file-pvalues.txt > ancestral_states.txt


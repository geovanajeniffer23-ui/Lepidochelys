## Start Python script
import gzip

fasta_in = "/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Historia_Demografica/SFS/Ancestralização/FASTA_com_N.fasta"
ancestral_file = "/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Historia_Demografica/SFS/Ancestralização/ancestral_positions.txt.gz"
fasta_out = "/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Historia_Demografica/SFS/Ancestralização/fasta_ancestralizado.fasta"
log_out = "/media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/SFS/Ancestralização/mismatches_REF_vs_ANC.log"

LINE_LEN = 60

ancestral = {}

with gzip.open(ancestral_file, "rt") as f:
    for line in f:
        chrom, pos, base = line.strip().split()
        ancestral.setdefault(chrom, {})[int(pos)] = base.upper()

print("Alelos ancestrais carregados.")

with open(fasta_in) as fin, open(fasta_out, "w") as fout, open(log_out, "w") as flog:
    chrom = None
    seq = []

    def write_seq(chrom, seq):
        s = list("".join(seq))

        if chrom in ancestral:
            for pos, anc in ancestral[chrom].items():
                if pos - 1 < len(s):
                    ref = s[pos - 1]
                    if ref.upper() != anc:
                        flog.write(f"{chrom}\t{pos}\t{ref}\t{anc}\n")
                    s[pos - 1] = anc

        for i in range(0, len(s), LINE_LEN):
            fout.write("".join(s[i:i+LINE_LEN]) + "\n")

    for line in fin:
        line = line.rstrip("\n")

        if line.startswith(">"):
            if chrom is not None:
                write_seq(chrom, seq)

            chrom = line[1:].split()[0]
            fout.write(line + "\n")
            seq = []
        else:
            seq.append(line)

    if chrom is not None:
        write_seq(chrom, seq)

print("FASTA com alelos ancestrais gerado com sucesso!")
print(f"Log salvo em: {log_out}")


################################################################ Heterozygosity ################################################################

# Total heterozygosity
vcftools --gzvcf L.olivacea_12.vcf.gz \
--minDP 4 \
--het \
--out /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Heterogosidade/L.olivacea_12_het_por_amostra

# Intergenic heterozygosity
vcftools --gzvcf L.olivacea_12.vcf.gz \
--minDP 4 \
--bed /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Regiões_confiáveis/regiões_confiáveis_intergênicas.bed \
--het \
--out /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Heterogosidade/L.olivaceaa_12_intergenico_het_por_amostra

# Intergenic heterozygosity
vcftools --gzvcf L.olivacea_12.vcf.gz \
--minDP 4 \
--bed /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Regiões_confiáveis/regiões_confiáveis_gênicas.bed \
--het \
--out /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/Heterogosidade/L.olivaceaa_12_genico_het_por_amostra


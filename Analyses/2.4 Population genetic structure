################################################################ PCA ################################################################

# Generate the PLINK input file
plink --vcf L.olivacea_11_Atlantico.vcf.gz  --double-id --allow-extra-chr --make-bed --out /media/labgenoma5/DATAPART4/ortela/Mestrado_L.olivacea/PCA/Atlantico/L.olivacea_11_Atlantico --threads 10 --memory 8000

# Run the PCA
plink --bfile L.olivacea_11_Atlantico --pca 10 --out L.olivacea_11_Atlantico --allow-extra-chr  --threads 10 --memory 8000

############################################################## ADMIXTURE ##############################################################

# ADMIXTURE does not support chromosome names containing letters, as in this case. Therefore, rename them so that they contain only numbers

bcftools annotate \
    --rename-chrs teste_Gone.txt \
    -Oz \
    -o L.olivacea_11_NEW.vcf.gz \
    L.olivacea_11.vcf.gz

